{
  "name": "agholding-staff-desktop",
  "version": "1.0.4",
  "description": "AG Holding Staff — desktop app for the staff portal",
  "main": "main.js",
  "author": "Asia General Holding Co., Ltd.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.agholding.staff",
    "productName": "AG Holding Staff",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "daCortex",
        "repo": "agholding-staff-desktop"
      }
    ],
    "files": [
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "artifactName": "AG-Holding-Staff-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "AG Holding Staff ${version}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AG-Holding-Staff-${version}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Asia General Holding Co., Ltd."
    }
  }
}